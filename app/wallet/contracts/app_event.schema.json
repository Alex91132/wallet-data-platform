{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alex91132/wallet-data-platform/contracts/app_event.schema.json",
  "title": "Событие мобильного приложения",
  "description": "Контракт клиентских событий. Сборщик /track проверяет каждое событие; нарушившие контракт уходят в топик app_events_dlq с причиной. Версия контракта — schema_version; несовместимые изменения — только с новой мажорной версией.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_name", "anonymous_id", "session_id", "client_ts", "platform", "app_version", "properties"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid", "description": "Генерирует клиент; повтор отправки — тот же id (дедупликация в хранилище)"},
    "event_name": {"enum": ["app_open", "screen_view", "signup_completed", "kyc_started", "kyc_step_completed", "kyc_submitted",
                            "topup_started", "transfer_started", "purchase_started", "experiment_exposure"]},
    "user_id": {"type": ["integer", "null"], "minimum": 1, "description": "null до регистрации"},
    "anonymous_id": {"type": "string", "minLength": 8, "maxLength": 64, "description": "Идентификатор установки приложения"},
    "session_id": {"type": "string", "minLength": 8, "maxLength": 64},
    "client_ts": {"type": "string", "format": "date-time", "description": "Время на устройстве; события из офлайна приходят с опозданием"},
    "platform": {"enum": ["ios", "android", "web"]},
    "app_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "properties": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"event_name": {"const": "screen_view"}}},
     "then": {"properties": {"properties": {"type": "object", "required": ["screen"], "additionalProperties": false,
       "properties": {"screen": {"enum": ["home", "onboarding", "kyc_form", "topup", "transfer", "pay", "history", "profile", "cashback_banner"]}}}}}},
    {"if": {"properties": {"event_name": {"const": "signup_completed"}}},
     "then": {"required": ["user_id"], "properties": {"user_id": {"type": "integer"},
       "properties": {"type": "object", "required": ["channel"], "properties": {"channel": {"enum": ["organic", "referral", "ads_social", "ads_search", "partner"]}}}}}},
    {"if": {"properties": {"event_name": {"enum": ["kyc_started", "kyc_submitted"]}}},
     "then": {"required": ["user_id"], "properties": {"user_id": {"type": "integer"},
       "properties": {"type": "object", "required": ["level"], "properties": {"level": {"enum": ["basic", "full"]}}}}}},
    {"if": {"properties": {"event_name": {"const": "kyc_step_completed"}}},
     "then": {"required": ["user_id"], "properties": {"user_id": {"type": "integer"},
       "properties": {"type": "object", "required": ["step", "form_version"],
         "properties": {"step": {"enum": ["passport", "selfie", "address"]}, "form_version": {"enum": ["v1", "v2"]}}}}}},
    {"if": {"properties": {"event_name": {"enum": ["topup_started", "transfer_started", "purchase_started"]}}},
     "then": {"required": ["user_id"], "properties": {"user_id": {"type": "integer"},
       "properties": {"type": "object", "required": ["amount"], "properties": {"amount": {"type": "number", "exclusiveMinimum": 0}}}}}},
    {"if": {"properties": {"event_name": {"const": "experiment_exposure"}}},
     "then": {"required": ["user_id"], "properties": {"user_id": {"type": "integer"},
       "properties": {"type": "object", "required": ["experiment_key", "variant"],
         "properties": {"experiment_key": {"type": "string"}, "variant": {"enum": ["control", "test"]}}}}}}
  ]
}
