  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KycDecision": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "examples": [
              "document_unreadable"
            ]
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "KycDecision"
      },
      "KycIn": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "full"
            ],
            "title": "Level"
          }
        },
        "type": "object",
        "required": [
          "level"
        ],
        "title": "KycIn"
      },
      "OperationResult": {
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid",
            "title": "Op Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "succeeded",
              "failed",
              "reversed"
            ],
            "title": "Status"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason",
            "examples": [
              "insufficient_funds",
              "daily_limit",
              "kyc_required"
            ]
          }
        },
        "type": "object",
        "required": [
          "op_id",
          "status"
        ],
        "title": "OperationResult"
      },
      "PurchaseIn": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "merchant_id": {
            "type": "integer",
            "title": "Merchant Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "1500.00"
            ]
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "merchant_id",
          "amount"
        ],
        "title": "PurchaseIn"
      },
      "RefundIn": {
        "properties": {
          "purchase_op_id": {
            "type": "string",
            "format": "uuid",
            "title": "Purchase Op Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "1500.00"
            ]
          }
        },
        "type": "object",
        "required": [
          "purchase_op_id",
          "amount"
        ],
        "title": "RefundIn"
      },
      "TopupIn": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "1500.00"
            ]
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "amount"
        ],
        "title": "TopupIn"
      },
      "TransferIn": {
        "properties": {
          "from_user_id": {
            "type": "integer",
            "title": "From User Id"
          },
          "to_user_id": {
            "type": "integer",
            "title": "To User Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "1500.00"
            ]
          }
        },
        "type": "object",
        "required": [
          "from_user_id",
          "to_user_id",
          "amount"
        ],
        "title": "TransferIn"
      },
      "UserIn": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+7\\d{10}$",
            "title": "Phone",
            "examples": [
              "+79991234567"
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "title": "Birth Date"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "channel": {
            "type": "string",
            "enum": [
              "organic",
              "referral",
              "ads_social",
              "ads_search",
              "partner"
            ],
            "title": "Channel"
          }
        },
        "type": "object",
        "required": [
          "phone",
          "full_name",
          "birth_date",
          "channel"
        ],
        "title": "UserIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WithdrawIn": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "1500.00"
            ]
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "amount"
        ],
        "title": "WithdrawIn"
      }
    }
  }
